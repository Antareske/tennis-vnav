#!/bin/sh
# tennis-vnav 开机自启（BusyBox rcS 约定：S 前缀按序执行）
# 部署: cp services/S99vnav /etc/init.d/S99vnav && chmod +x /etc/init.d/S99vnav
# 顺序: S98apstart（AP 热点，内含 sleep 20）之后执行，此时 WiFi 已就绪

# UART pinmux（ESP32 电机 /dev/ttyS1）；失败显式告警（不再静默）
if ! devmem 0x03001064 32 0x6; then echo "[vnav] pinmux devmem 0x03001064 失败" >&2; fi
if ! devmem 0x03001068 32 0x6; then echo "[vnav] pinmux devmem 0x03001068 失败" >&2; fi

# 网页控制服务（保活循环：panic/异常退出后自动重启）
while :; do
    /root/tennis-vnav/ctrl-serve > /tmp/ctrl-serve.log 2>&1
    echo "[vnav] ctrl-serve 退出，3s 后重启" >> /tmp/vnav.log
    sleep 3
done &

# 导航 + 数采进程（保活循环：崩溃后自动重启；main.py 内有 SIGTERM 急停兜底）
cd /root/tennis-vnav
while :; do
    env LD_LIBRARY_PATH=/root/tennis-vnav/cvi-libs:/usr/bin/dl_lib:/usr/bin/lib \
        python3 main.py >> /tmp/vnav.log 2>&1
    echo "[vnav] main.py 退出（code $?），3s 后重启" >> /tmp/vnav.log
    sleep 3
done &

exit 0
