#!/bin/sh
# tennis-vnav 开机自启（BusyBox rcS 约定：S 前缀按序执行）
# 部署: cp services/S99vnav /etc/init.d/S99vnav && chmod +x /etc/init.d/S99vnav
# 顺序: S98apstart（AP 热点，内含 sleep 20）之后执行，此时 WiFi 已就绪

# UART pinmux（ESP32 电机 /dev/ttyS1）
devmem 0x03001064 32 0x6 2>/dev/null
devmem 0x03001068 32 0x6 2>/dev/null

# 网页控制服务（HTML 编译进二进制，端口 80）
nohup /root/tennis-vnav/ctrl-serve > /tmp/ctrl-serve.log 2>&1 &

# 导航 + 数采进程
cd /root/tennis-vnav
nohup env LD_LIBRARY_PATH=/usr/bin/dl_lib python3 main.py > /tmp/vnav.log 2>&1 &

exit 0
