# tennis-vnav systemd 服务
#
# 安装:
#   sudo cp services/tennis-vnav.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable tennis-vnav
#
# 管理:
#   sudo systemctl start tennis-vnav       # 启动
#   sudo systemctl stop tennis-vnav        # 停止
#   sudo systemctl restart tennis-vnav     # 重启
#   sudo systemctl status tennis-vnav      # 状态
#   journalctl -u tennis-vnav -f           # 实时日志
#
# 注意: 此服务依赖 tennis-vnav-ap.service（WiFi AP），
#       如果不需要 AP 模式，编辑 After/Requires 行。

[Unit]
Description=tennis-vnav Visual Navigation
Documentation=https://github.com/chenlong-robot/AKA-00
After=network.target network-online.target tennis-vnav-ap.service
Wants=network.target network-online.target tennis-vnav-ap.service
Requires=tennis-vnav-ap.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/tennis-vnav
ExecStart=/root/tennis-vnav/scripts/start.sh
ExecStop=/bin/sh -c 'kill -TERM $(cat /var/run/tennis-vnav.pid 2>/dev/null) 2>/dev/null; sleep 1; killall -9 python3 2>/dev/null || true'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tennis-vnav

# 安全加固（可选）
# NoNewPrivileges=yes
# ProtectSystem=strict
# ProtectHome=yes
# ReadWritePaths=/root/tennis-vnav /tmp

[Install]
WantedBy=multi-user.target
