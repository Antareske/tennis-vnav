# tennis-vnav 摄像头持久化设备名
# USB UVC HD Camera (1e45:8022) → /dev/tennis-camera
#
# 安装:
#   sudo cp services/99-tennis-camera.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# USB 断连重连后设备名不变，代码中使用 /dev/tennis-camera 即可。

SUBSYSTEM=="video4linux", ATTRS{idVendor}=="1e45", ATTRS{idProduct}=="8022", SYMLINK+="tennis-camera"
